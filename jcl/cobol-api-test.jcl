//SQLATST  JOB (ACCT),'API TEST',CLASS=A,MSGCLASS=H,MSGLEVEL=(1,1)
//COB      EXEC PGM=IKFCBL00,PARM='LOAD,SIZE=2048K,BUF=1024K'
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(460,(700,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(460,(700,100))
//SYSUT3   DD UNIT=SYSDA,SPACE=(460,(700,100))
//SYSUT4   DD UNIT=SYSDA,SPACE=(460,(700,100))
//SYSLIN   DD DSN=&&COBOBJ,DISP=(NEW,PASS),UNIT=SYSDA,
// SPACE=(TRK,(5,5)),DCB=(RECFM=FB,LRECL=80,BLKSIZE=3200)
//SYSLIB   DD DISP=SHR,DSN=SYS1.COBLIB
//SYSPUNCH DD DUMMY
//SYSIN    DD *
       IDENTIFICATION DIVISION.
       PROGRAM-ID. SQLATST.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  SQL-TEXT              PIC X(4096).
       01  SQL-LENGTH            PIC S9(4) COMP.
       01  API-OUTPUT            PIC X(9999).
       01  API-OUTPUT-BYTES REDEFINES API-OUTPUT.
           05  OUTPUT-BYTE       PIC X OCCURS 9999 TIMES.
       01  OUTPUT-CAPACITY       PIC S9(4) COMP VALUE +9999.
       01  OUTPUT-LENGTH         PIC S9(4) COMP.
       01  API-RETURN-CODE       PIC S9(4) COMP.
       01  BYTE-ID               PIC S9(4) COMP.
       01  LINE-ID               PIC S9(4) COMP.
       01  PRINT-LINE            PIC X(120).
       01  PRINT-BYTES REDEFINES PRINT-LINE.
           05  PRINT-BYTE        PIC X OCCURS 120 TIMES.
       01  NL-NUMBER             PIC S9(4) COMP VALUE +21.
       01  NL-BYTES REDEFINES NL-NUMBER.
           05  FILLER            PIC X.
           05  API-NEWLINE       PIC X.
       01  TEST-STATUS           PIC S9(4) COMP VALUE +0.
       PROCEDURE DIVISION.
           DISPLAY 'SQLITE COBOL API TEST START'.
           MOVE SPACES TO SQL-TEXT.
           MOVE 'SELECT COUNT(*) AS PEOPLE FROM PEOPLE;' TO SQL-TEXT.
           MOVE 39 TO SQL-LENGTH.
           PERFORM RUN-SQL THRU RUN-SQL-END.
           MOVE SPACES TO SQL-TEXT.
           MOVE 'SELECT COUNT(*) AS ORDERS FROM ORDERS;' TO SQL-TEXT.
           MOVE 39 TO SQL-LENGTH.
           PERFORM RUN-SQL THRU RUN-SQL-END.
           DISPLAY 'SQLITE COBOL API TEST END'.
           MOVE TEST-STATUS TO RETURN-CODE.
           STOP RUN.
       RUN-SQL.
           MOVE SPACES TO API-OUTPUT.
           MOVE 0 TO OUTPUT-LENGTH API-RETURN-CODE.
           CALL 'SQLITEA' USING SQL-TEXT SQL-LENGTH API-OUTPUT
                OUTPUT-CAPACITY OUTPUT-LENGTH API-RETURN-CODE.
           DISPLAY 'API RC: ' API-RETURN-CODE.
           IF API-RETURN-CODE NOT = 0 MOVE 12 TO TEST-STATUS.
           IF OUTPUT-LENGTH < 0 OR OUTPUT-LENGTH > OUTPUT-CAPACITY
               MOVE 12 TO TEST-STATUS MOVE 0 TO OUTPUT-LENGTH.
           MOVE SPACES TO PRINT-LINE.
           MOVE 1 TO LINE-ID BYTE-ID.
           PERFORM PRINT-OUTPUT THRU PRINT-OUTPUT-END
               UNTIL BYTE-ID > OUTPUT-LENGTH.
           IF LINE-ID > 1 DISPLAY PRINT-LINE.
       RUN-SQL-END.
           EXIT.
       PRINT-OUTPUT.
           IF OUTPUT-BYTE (BYTE-ID) = API-NEWLINE
               DISPLAY PRINT-LINE
               MOVE SPACES TO PRINT-LINE
               MOVE 1 TO LINE-ID
               ADD 1 TO BYTE-ID
               GO TO PRINT-OUTPUT-END.
           MOVE OUTPUT-BYTE (BYTE-ID) TO PRINT-BYTE (LINE-ID).
           ADD 1 TO LINE-ID BYTE-ID.
           IF LINE-ID > 120
               DISPLAY PRINT-LINE
               MOVE SPACES TO PRINT-LINE
               MOVE 1 TO LINE-ID.
       PRINT-OUTPUT-END.
           EXIT.
/*
//GO       EXEC PGM=LOADER,PARM='MAP,NOLET',REGION=4096K,
//         COND=(4,LT,COB)
//STEPLIB  DD DISP=SHR,DSN=IBMUSER.SQLITE.D534.LOAD
//SYSLIN   DD DSN=&&COBOBJ,DISP=(OLD,DELETE)
//         DD DISP=SHR,DSN=IBMUSER.SQLITE.BRG80
//SYSLIB   DD DISP=SHR,DSN=SYS1.COBLIB
//SYSLOUT  DD SYSOUT=*
//SQLDB    DD DISP=SHR,DSN=IBMUSER.SQLITE.TESTDB
//SQLJRN   DD DISP=SHR,DSN=IBMUSER.SQLITE.TESTJRN
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
