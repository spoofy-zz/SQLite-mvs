//SQLTSEED JOB (ACCT),'SEED D534',CLASS=A,MSGCLASS=H,MSGLEVEL=(1,1)
//* RECREATES PEOPLE/ORDERS IN THE DATABASE USED BY THE SQLITE COMMAND.
//* OTHER TABLES IN D534DB ARE PRESERVED.
//SEED     EXEC PGM=SQLT534,PARM='SEED',REGION=4096K
//STEPLIB  DD DISP=SHR,DSN=IBMUSER.SQLITE.D534.LOAD
//SQLDB    DD DISP=SHR,DSN=IBMUSER.SQLITE.D534DB
//SQLJRN   DD DISP=SHR,DSN=IBMUSER.SQLITE.D534JRN
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
