       IDENTIFICATION DIVISION.
       PROGRAM-ID. SQLKDETL.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  AID-PF3                 PIC X VALUE X'F3'.
       01  AID-PF4                 PIC X VALUE X'F4'.
       01  AID-PF5                 PIC X VALUE X'F5'.
       01  AID-PF6                 PIC X VALUE X'F6'.
       01  AID-PF9                 PIC X VALUE X'F9'.
       01  AID-PF10                PIC X VALUE X'7A'.
       01  WS-RESP                 PIC S9(8) COMP VALUE +0.
       01  WS-CA.
           05 WS-CA-ID             PIC X(5) VALUE SPACES.
           05 WS-CA-CONFIRM        PIC X VALUE 'N'.
       01  WS-ORDERS-SQL.
           05 FILLER PIC X(43) VALUE
              'SELECT ID,ITEM,QUANTITY,AMOUNT FROM ORDERS '.
           05 FILLER PIC X(29) VALUE
              'WHERE PEOPLE_ID=? ORDER BY ID'.
       01  DB-ID                   PIC X(5) VALUE SPACES.
       01  DB-NAME                 PIC X(20) VALUE SPACES.
       01  DB-CITY                 PIC X(20) VALUE SPACES.
       01  DB-AGE                  PIC X(3) VALUE SPACES.
       01  WS-I                    PIC S9(4) COMP VALUE +0.
       01  WS-NOTICE               PIC X(76) VALUE SPACES.
       01  WS-RESULT-LINES.
           05 WS-RESULT-LINE OCCURS 10 TIMES.
              10 WS-R-ID           PIC X(8).
              10 FILLER            PIC X.
              10 WS-R-ITEM         PIC X(18).
              10 FILLER            PIC X.
              10 WS-R-QTY          PIC X(12).
              10 FILLER            PIC X.
              10 WS-R-AMOUNT       PIC X(15).
      * SQLite MVS structured COBOL API v2 request block
       01  SQLX-REQUEST.
           05 SQLX-OPERATION       PIC X(8).
           05 SQLX-SQL-LENGTH      PIC S9(4) COMP.
           05 SQLX-SQL             PIC X(2048).
           05 SQLX-BIND-COUNT      PIC S9(4) COMP.
           05 SQLX-BINDS OCCURS 8 TIMES.
              10 SQLX-BIND-TYPE    PIC X.
              10 FILLER            PIC X.
              10 SQLX-BIND-LENGTH  PIC S9(4) COMP.
              10 SQLX-BIND-VALUE   PIC X(64).
           05 SQLX-MAX-ROWS        PIC S9(4) COMP.
           05 SQLX-ROW-COUNT       PIC S9(4) COMP.
           05 SQLX-COLUMN-COUNT    PIC S9(4) COMP.
           05 SQLX-CHANGES         PIC S9(4) COMP.
           05 SQLX-RETURN-CODE     PIC S9(4) COMP.
           05 SQLX-MESSAGE-LENGTH  PIC S9(4) COMP.
           05 SQLX-MESSAGE         PIC X(160).
           05 SQLX-COLUMN-NAME OCCURS 16 TIMES PIC X(32).
           05 SQLX-ROWS OCCURS 10 TIMES.
              10 SQLX-CELLS OCCURS 16 TIMES.
                 15 SQLX-CELL-TYPE   PIC X.
                 15 FILLER            PIC X.
                 15 SQLX-CELL-LENGTH PIC S9(4) COMP.
                 15 SQLX-CELL-VALUE  PIC X(64).
      * SQLite embedded-SQL compatibility area
       01  SQLCA.
           05 SQLCODE             PIC S9(4) COMP VALUE +0.
           05 SQLROWC             PIC S9(4) COMP VALUE +0.
           05 SQLCHNG             PIC S9(4) COMP VALUE +0.
           05 SQLERRM             PIC X(160) VALUE SPACES.
       01  SQLE-SQL-0001.
           05 FILLER PIC X(44) VALUE
              'SELECT NAME, CITY, AGE FROM PEOPLE WHERE ID '.
           05 FILLER PIC X(3) VALUE
              '= ?'.
       01  SQLE-SQL-0002.
           05 FILLER PIC X(44) VALUE
              'UPDATE PEOPLE SET NAME = RTRIM(?), CITY = RT'.
           05 FILLER PIC X(28) VALUE
              'RIM(?), AGE = ? WHERE ID = ?'.
       01  SQLE-SQL-0003.
           05 FILLER PIC X(44) VALUE
              'INSERT INTO PEOPLE(ID, NAME, CITY, AGE) VALU'.
           05 FILLER PIC X(28) VALUE
              'ES(?, RTRIM(?), RTRIM(?), ?)'.
       01  SQLE-SQL-0004.
           05 FILLER PIC X(31) VALUE
              'DELETE FROM PEOPLE WHERE ID = ?'.
       01  SQLE-SQL-0005.
           05 FILLER PIC X(38) VALUE
              'DELETE FROM ORDERS WHERE PEOPLE_ID = ?'.
           COPY SQLDMAP.
       LINKAGE SECTION.
       01  DFHCOMMAREA.
           05 CA-ID                PIC X(5).
           05 CA-CONFIRM           PIC X.
       PROCEDURE DIVISION.
       MAIN.
           IF EIBCALEN = 0
               PERFORM SEND-EMPTY THRU SEND-EMPTY-EXIT
               GO TO RETURN-DETAIL.
           MOVE CA-ID TO WS-CA-ID.
           IF EIBCALEN > 5 MOVE CA-CONFIRM TO WS-CA-CONFIRM.
           IF EIBCALEN = 5
               PERFORM LOAD-DETAIL THRU LOAD-DETAIL-EXIT
               GO TO RETURN-DETAIL.
           IF EIBAID = AID-PF3
               EXEC CICS SEND CONTROL ERASE FREEKB END-EXEC
               EXEC CICS RETURN TRANSID('SQLS') END-EXEC.
           IF EIBAID = AID-PF4
               PERFORM SEND-EMPTY THRU SEND-EMPTY-EXIT
               MOVE SPACES TO WS-CA-ID
               MOVE 'N' TO WS-CA-CONFIRM
               GO TO RETURN-DETAIL.
           EXEC CICS RECEIVE MAP('SQLDETL') MAPSET('SQLDMAP')
               INTO(SQLDETLI) RESP(WS-RESP) END-EXEC.
           IF DIDI NOT = LOW-VALUES AND DIDI NOT = SPACES
               MOVE DIDI TO WS-CA-ID.
           IF EIBAID = AID-PF9
               MOVE 'Y' TO WS-CA-CONFIRM
               MOVE 'PF10 CONFIRMS DELETE; ANY OTHER KEY CANCELS'
                 TO WS-NOTICE
               PERFORM LOAD-DETAIL THRU LOAD-DETAIL-EXIT
               GO TO RETURN-DETAIL.
           IF EIBAID = AID-PF10
               PERFORM CONFIRM-DELETE THRU CONFIRM-DELETE-EXIT
               GO TO RETURN-DETAIL.
           MOVE 'N' TO WS-CA-CONFIRM.
           IF EIBAID = AID-PF5
               PERFORM UPDATE-PERSON THRU UPDATE-PERSON-EXIT
               GO TO RETURN-DETAIL.
           IF EIBAID = AID-PF6
               PERFORM INSERT-PERSON THRU INSERT-PERSON-EXIT
               GO TO RETURN-DETAIL.
           PERFORM LOAD-DETAIL THRU LOAD-DETAIL-EXIT.
           GO TO RETURN-DETAIL.
       INIT-REQUEST.
           MOVE SPACES TO SQLX-REQUEST.
           MOVE 0 TO SQLX-BIND-COUNT SQLX-RETURN-CODE.
           MOVE 'EXECUTE' TO SQLX-OPERATION.
           MOVE 10 TO SQLX-MAX-ROWS.
       INIT-REQUEST-EXIT.
           EXIT.
       BIND-ID-ONE.
           MOVE 1 TO SQLX-BIND-COUNT.
           MOVE 'I' TO SQLX-BIND-TYPE (1).
           MOVE 5 TO SQLX-BIND-LENGTH (1).
           MOVE WS-CA-ID TO SQLX-BIND-VALUE (1).
       BIND-ID-ONE-EXIT.
           EXIT.
       LOAD-DETAIL.
           MOVE LOW-VALUES TO SQLDETLO.
           MOVE SPACES TO WS-RESULT-LINES.
           IF WS-CA-ID = SPACES
               MOVE 'ENTER PERSON ID' TO MSGO
               GO TO SEND-DETAIL.
           MOVE WS-CA-ID TO DB-ID.
           MOVE SPACES TO SQLX-REQUEST.
           MOVE 0 TO SQLX-BIND-COUNT SQLX-RETURN-CODE.
           MOVE 'EXECUTE' TO SQLX-OPERATION.
           MOVE 1 TO SQLX-MAX-ROWS.
           MOVE SQLE-SQL-0001 TO SQLX-SQL.
           MOVE 47 TO SQLX-SQL-LENGTH.
           MOVE 1 TO SQLX-BIND-COUNT.
           MOVE 'T' TO SQLX-BIND-TYPE (1).
           MOVE 5 TO SQLX-BIND-LENGTH (1).
           MOVE DB-ID TO SQLX-BIND-VALUE (1).
           CALL 'SQLITEX' USING SQLX-REQUEST.
           MOVE SQLX-RETURN-CODE TO SQLCODE.
           MOVE SQLX-ROW-COUNT TO SQLROWC.
           MOVE SQLX-CHANGES TO SQLCHNG.
           MOVE SQLX-MESSAGE TO SQLERRM.
           IF SQLCODE = 0
               IF SQLROWC = 0
                   MOVE +100 TO SQLCODE
               ELSE
                   MOVE SQLX-CELL-VALUE (1, 1) TO DB-NAME
                   MOVE SQLX-CELL-VALUE (1, 2) TO DB-CITY
                   MOVE SQLX-CELL-VALUE (1, 3) TO DB-AGE.
           IF SQLCODE = +100
               MOVE 'N' TO WS-CA-CONFIRM
               MOVE WS-CA-ID TO DIDO
               MOVE 'PERSON NOT FOUND' TO MSGO
               GO TO SEND-DETAIL.
           IF SQLCODE NOT = 0
               PERFORM SET-API-ERROR THRU SET-API-ERROR-EXIT
               GO TO SEND-DETAIL.
           MOVE WS-CA-ID TO DIDO.
           MOVE DB-NAME TO DNAMEO.
           MOVE DB-CITY TO DCITYO.
           MOVE DB-AGE TO DAGEO.
           PERFORM INIT-REQUEST THRU INIT-REQUEST-EXIT.
           MOVE WS-ORDERS-SQL TO SQLX-SQL.
           MOVE 72 TO SQLX-SQL-LENGTH.
           PERFORM BIND-ID-ONE THRU BIND-ID-ONE-EXIT.
           CALL 'SQLITEX' USING SQLX-REQUEST.
           IF SQLX-RETURN-CODE NOT = 0
               PERFORM SET-API-ERROR THRU SET-API-ERROR-EXIT
               GO TO SEND-DETAIL.
           PERFORM FORMAT-ORDERS THRU FORMAT-ORDERS-EXIT.
           IF WS-NOTICE = SPACES
               MOVE 'PERSON AND ORDERS LOADED' TO MSGO
           ELSE
               MOVE WS-NOTICE TO MSGO.
       SEND-DETAIL.
           MOVE WS-RESULT-LINE (1) TO ROW01O.
           MOVE WS-RESULT-LINE (2) TO ROW02O.
           MOVE WS-RESULT-LINE (3) TO ROW03O.
           MOVE WS-RESULT-LINE (4) TO ROW04O.
           MOVE WS-RESULT-LINE (5) TO ROW05O.
           MOVE WS-RESULT-LINE (6) TO ROW06O.
           MOVE WS-RESULT-LINE (7) TO ROW07O.
           MOVE WS-RESULT-LINE (8) TO ROW08O.
           MOVE WS-RESULT-LINE (9) TO ROW09O.
           MOVE WS-RESULT-LINE (10) TO ROW10O.
           EXEC CICS SEND MAP('SQLDETL') MAPSET('SQLDMAP')
               FROM(SQLDETLO) ERASE FREEKB END-EXEC.
       LOAD-DETAIL-EXIT.
           EXIT.
       FORMAT-ORDERS.
           MOVE 1 TO WS-I.
       FORMAT-ORDERS-LOOP.
           IF WS-I > SQLX-ROW-COUNT GO TO FORMAT-ORDERS-EXIT.
           MOVE SQLX-CELL-VALUE (WS-I, 1) TO WS-R-ID (WS-I).
           MOVE SQLX-CELL-VALUE (WS-I, 2) TO WS-R-ITEM (WS-I).
           MOVE SQLX-CELL-VALUE (WS-I, 3) TO WS-R-QTY (WS-I).
           MOVE SQLX-CELL-VALUE (WS-I, 4) TO WS-R-AMOUNT (WS-I).
           ADD 1 TO WS-I.
           GO TO FORMAT-ORDERS-LOOP.
       FORMAT-ORDERS-EXIT.
           EXIT.
       VALIDATE-FIELDS.
           MOVE 0 TO SQLX-RETURN-CODE.
           IF WS-CA-ID = SPACES MOVE -1 TO SQLX-RETURN-CODE.
           IF DNAMEI = LOW-VALUES MOVE -1 TO SQLX-RETURN-CODE.
           IF DNAMEI = SPACES MOVE -1 TO SQLX-RETURN-CODE.
           IF DCITYI = LOW-VALUES MOVE -1 TO SQLX-RETURN-CODE.
           IF DCITYI = SPACES MOVE -1 TO SQLX-RETURN-CODE.
           IF DAGEI = LOW-VALUES MOVE -1 TO SQLX-RETURN-CODE.
           IF DAGEI = SPACES MOVE -1 TO SQLX-RETURN-CODE.
       VALIDATE-FIELDS-EXIT.
           EXIT.
       UPDATE-PERSON.
           PERFORM VALIDATE-FIELDS THRU VALIDATE-FIELDS-EXIT.
           IF SQLX-RETURN-CODE NOT = 0
               PERFORM SEND-VALIDATION THRU SEND-VALIDATION-EXIT
               GO TO UPDATE-PERSON-EXIT.
           MOVE WS-CA-ID TO DB-ID.
           MOVE DNAMEI TO DB-NAME.
           MOVE DCITYI TO DB-CITY.
           MOVE DAGEI TO DB-AGE.
           MOVE SPACES TO SQLX-REQUEST.
           MOVE 0 TO SQLX-BIND-COUNT SQLX-RETURN-CODE.
           MOVE 'EXECUTE' TO SQLX-OPERATION.
           MOVE 1 TO SQLX-MAX-ROWS.
           MOVE SQLE-SQL-0002 TO SQLX-SQL.
           MOVE 72 TO SQLX-SQL-LENGTH.
           MOVE 4 TO SQLX-BIND-COUNT.
           MOVE 'T' TO SQLX-BIND-TYPE (1).
           MOVE 20 TO SQLX-BIND-LENGTH (1).
           MOVE DB-NAME TO SQLX-BIND-VALUE (1).
           MOVE 'T' TO SQLX-BIND-TYPE (2).
           MOVE 20 TO SQLX-BIND-LENGTH (2).
           MOVE DB-CITY TO SQLX-BIND-VALUE (2).
           MOVE 'T' TO SQLX-BIND-TYPE (3).
           MOVE 3 TO SQLX-BIND-LENGTH (3).
           MOVE DB-AGE TO SQLX-BIND-VALUE (3).
           MOVE 'T' TO SQLX-BIND-TYPE (4).
           MOVE 5 TO SQLX-BIND-LENGTH (4).
           MOVE DB-ID TO SQLX-BIND-VALUE (4).
           CALL 'SQLITEX' USING SQLX-REQUEST.
           MOVE SQLX-RETURN-CODE TO SQLCODE.
           MOVE SQLX-ROW-COUNT TO SQLROWC.
           MOVE SQLX-CHANGES TO SQLCHNG.
           MOVE SQLX-MESSAGE TO SQLERRM.
           IF SQLCODE NOT = 0
               PERFORM SEND-API-ERROR THRU SEND-API-ERROR-EXIT
               GO TO UPDATE-PERSON-EXIT.
           MOVE 'PERSON UPDATED' TO WS-NOTICE.
           PERFORM LOAD-DETAIL THRU LOAD-DETAIL-EXIT.
       UPDATE-PERSON-EXIT.
           EXIT.
       INSERT-PERSON.
           PERFORM VALIDATE-FIELDS THRU VALIDATE-FIELDS-EXIT.
           IF SQLX-RETURN-CODE NOT = 0
               PERFORM SEND-VALIDATION THRU SEND-VALIDATION-EXIT
               GO TO INSERT-PERSON-EXIT.
           MOVE WS-CA-ID TO DB-ID.
           MOVE DNAMEI TO DB-NAME.
           MOVE DCITYI TO DB-CITY.
           MOVE DAGEI TO DB-AGE.
           MOVE SPACES TO SQLX-REQUEST.
           MOVE 0 TO SQLX-BIND-COUNT SQLX-RETURN-CODE.
           MOVE 'EXECUTE' TO SQLX-OPERATION.
           MOVE 1 TO SQLX-MAX-ROWS.
           MOVE SQLE-SQL-0003 TO SQLX-SQL.
           MOVE 72 TO SQLX-SQL-LENGTH.
           MOVE 4 TO SQLX-BIND-COUNT.
           MOVE 'T' TO SQLX-BIND-TYPE (1).
           MOVE 5 TO SQLX-BIND-LENGTH (1).
           MOVE DB-ID TO SQLX-BIND-VALUE (1).
           MOVE 'T' TO SQLX-BIND-TYPE (2).
           MOVE 20 TO SQLX-BIND-LENGTH (2).
           MOVE DB-NAME TO SQLX-BIND-VALUE (2).
           MOVE 'T' TO SQLX-BIND-TYPE (3).
           MOVE 20 TO SQLX-BIND-LENGTH (3).
           MOVE DB-CITY TO SQLX-BIND-VALUE (3).
           MOVE 'T' TO SQLX-BIND-TYPE (4).
           MOVE 3 TO SQLX-BIND-LENGTH (4).
           MOVE DB-AGE TO SQLX-BIND-VALUE (4).
           CALL 'SQLITEX' USING SQLX-REQUEST.
           MOVE SQLX-RETURN-CODE TO SQLCODE.
           MOVE SQLX-ROW-COUNT TO SQLROWC.
           MOVE SQLX-CHANGES TO SQLCHNG.
           MOVE SQLX-MESSAGE TO SQLERRM.
           IF SQLCODE NOT = 0
               PERFORM SEND-API-ERROR THRU SEND-API-ERROR-EXIT
               GO TO INSERT-PERSON-EXIT.
           MOVE 'PERSON ADDED' TO WS-NOTICE.
           PERFORM LOAD-DETAIL THRU LOAD-DETAIL-EXIT.
       INSERT-PERSON-EXIT.
           EXIT.
       CONFIRM-DELETE.
           IF WS-CA-CONFIRM NOT = 'Y'
               MOVE 'PRESS PF9 BEFORE PF10 DELETE' TO WS-NOTICE
               PERFORM LOAD-DETAIL THRU LOAD-DETAIL-EXIT
               GO TO CONFIRM-DELETE-EXIT.
           PERFORM DELETE-ORDERS THRU DELETE-ORDERS-EXIT.
           IF SQLX-RETURN-CODE NOT = 0
               PERFORM SEND-API-ERROR THRU SEND-API-ERROR-EXIT
               GO TO CONFIRM-DELETE-EXIT.
           MOVE WS-CA-ID TO DB-ID.
           MOVE SPACES TO SQLX-REQUEST.
           MOVE 0 TO SQLX-BIND-COUNT SQLX-RETURN-CODE.
           MOVE 'EXECUTE' TO SQLX-OPERATION.
           MOVE 1 TO SQLX-MAX-ROWS.
           MOVE SQLE-SQL-0004 TO SQLX-SQL.
           MOVE 31 TO SQLX-SQL-LENGTH.
           MOVE 1 TO SQLX-BIND-COUNT.
           MOVE 'T' TO SQLX-BIND-TYPE (1).
           MOVE 5 TO SQLX-BIND-LENGTH (1).
           MOVE DB-ID TO SQLX-BIND-VALUE (1).
           CALL 'SQLITEX' USING SQLX-REQUEST.
           MOVE SQLX-RETURN-CODE TO SQLCODE.
           MOVE SQLX-ROW-COUNT TO SQLROWC.
           MOVE SQLX-CHANGES TO SQLCHNG.
           MOVE SQLX-MESSAGE TO SQLERRM.
           IF SQLCODE NOT = 0
               PERFORM SEND-API-ERROR THRU SEND-API-ERROR-EXIT
               GO TO CONFIRM-DELETE-EXIT.
           MOVE SPACES TO WS-CA-ID.
           MOVE 'N' TO WS-CA-CONFIRM.
           MOVE LOW-VALUES TO SQLDETLO.
           MOVE 'ENTER ID TO LOAD OR ALL FIELDS TO ADD' TO INFOO.
           MOVE 'PERSON AND ORDERS DELETED' TO MSGO.
           EXEC CICS SEND MAP('SQLDETL') MAPSET('SQLDMAP')
               FROM(SQLDETLO) ERASE FREEKB END-EXEC.
       CONFIRM-DELETE-EXIT.
           EXIT.
       DELETE-ORDERS.
           MOVE WS-CA-ID TO DB-ID.
           MOVE SPACES TO SQLX-REQUEST.
           MOVE 0 TO SQLX-BIND-COUNT SQLX-RETURN-CODE.
           MOVE 'EXECUTE' TO SQLX-OPERATION.
           MOVE 1 TO SQLX-MAX-ROWS.
           MOVE SQLE-SQL-0005 TO SQLX-SQL.
           MOVE 38 TO SQLX-SQL-LENGTH.
           MOVE 1 TO SQLX-BIND-COUNT.
           MOVE 'T' TO SQLX-BIND-TYPE (1).
           MOVE 5 TO SQLX-BIND-LENGTH (1).
           MOVE DB-ID TO SQLX-BIND-VALUE (1).
           CALL 'SQLITEX' USING SQLX-REQUEST.
           MOVE SQLX-RETURN-CODE TO SQLCODE.
           MOVE SQLX-ROW-COUNT TO SQLROWC.
           MOVE SQLX-CHANGES TO SQLCHNG.
           MOVE SQLX-MESSAGE TO SQLERRM.
       DELETE-ORDERS-EXIT.
           EXIT.
       SET-API-ERROR.
           MOVE SQLX-MESSAGE TO INFOO.
           MOVE 'SQLITEX ERROR - SEE MESSAGE' TO MSGO.
       SET-API-ERROR-EXIT.
           EXIT.
       SEND-API-ERROR.
           MOVE LOW-VALUES TO SQLDETLO.
           PERFORM SET-API-ERROR THRU SET-API-ERROR-EXIT.
           EXEC CICS SEND MAP('SQLDETL') MAPSET('SQLDMAP')
               FROM(SQLDETLO) ERASE FREEKB END-EXEC.
       SEND-API-ERROR-EXIT.
           EXIT.
       SEND-VALIDATION.
           MOVE LOW-VALUES TO SQLDETLO.
           MOVE WS-CA-ID TO DIDO.
           MOVE 'ID, NAME, CITY AND AGE ARE REQUIRED' TO MSGO.
           EXEC CICS SEND MAP('SQLDETL') MAPSET('SQLDMAP')
               FROM(SQLDETLO) ERASE FREEKB END-EXEC.
       SEND-VALIDATION-EXIT.
           EXIT.
       SEND-EMPTY.
           MOVE LOW-VALUES TO SQLDETLO.
           MOVE 'ENTER ID TO LOAD OR ALL FIELDS TO ADD' TO INFOO.
           MOVE 'READY' TO MSGO.
           EXEC CICS SEND MAP('SQLDETL') MAPSET('SQLDMAP')
               FROM(SQLDETLO) ERASE FREEKB END-EXEC.
       SEND-EMPTY-EXIT.
           EXIT.
       RETURN-DETAIL.
           EXEC CICS RETURN TRANSID('SQLD') COMMAREA(WS-CA)
               LENGTH(6) END-EXEC.
           STOP RUN.
