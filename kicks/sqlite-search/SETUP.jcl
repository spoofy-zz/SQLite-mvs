//SQLKSET  JOB (ACCT),'SQLK SET',CLASS=A,MSGCLASS=H,MSGLEVEL=(1,1)
//DELETE   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE IBMUSER.SQLITE.SOURCE PURGE
  IF LASTCC = 8 THEN SET MAXCC = 0
  DELETE IBMUSER.SQLITE.KLOAD PURGE
  IF LASTCC = 8 THEN SET MAXCC = 0
/*
//SOURCE   EXEC PGM=IEFBR14,COND=(0,NE)
