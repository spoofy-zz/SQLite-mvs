// UNIT=SYSDA,SPACE=(TRK,(5,2,10)),
// DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=3200)
//KLOAD    EXEC PGM=IEFBR14,COND=(0,NE)
//PDS      DD DSN=IBMUSER.SQLITE.KLOAD,DISP=(NEW,CATLG,DELETE),
// UNIT=SYSDA,SPACE=(TRK,(10,5,20)),
// DCB=(DSORG=PO,RECFM=U,BLKSIZE=32760)
