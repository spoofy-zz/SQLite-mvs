PROC 0
CONTROL NOMSG
FREE FI(SQLDB SQLJRN)
ALLOC FI(SQLDB) DA('IBMUSER.SQLITE.RRDS') SHR
IF &LASTCC NE 0 THEN DO
  WRITE ERROR: CANNOT ALLOCATE IBMUSER.SQLITE.RRDS
  EXIT CODE(&LASTCC)
END
ALLOC FI(SQLJRN) DA('IBMUSER.SQLITE.JOURNAL') SHR
IF &LASTCC NE 0 THEN DO
  WRITE ERROR: CANNOT ALLOCATE IBMUSER.SQLITE.JOURNAL
  FREE FI(SQLDB)
  EXIT CODE(&LASTCC)
END
CALL 'IBMUSER.SQLITE.LOAD(SQLITSO)'
SET RC = &LASTCC
FREE FI(SQLDB SQLJRN)
EXIT CODE(&RC)
